# Divechain Indexer — runtime configuration (Node process, so env vars ARE correct here,
# unlike the frontend bundle where contract addresses are compile-time constants).

# Factory deployments (verified byte-identical to repo compilation, 2026-09)
FUJI_FACTORY_ADDRESS=0x921dc74BA049748BdFeE471F641f48688aDF8b49
AVAX_FACTORY_ADDRESS=0x3894070DDdA804f9ba96116c9bd810eF745f5999

# Deployment blocks (binary-searched creation heights) — keeps getLogs ranges tight
FUJI_START_BLOCK=58140628
AVAX_START_BLOCK=94307082

# RPC endpoints (defaults shown; use a dedicated provider in production)
# FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# AVAX_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Poll cadence (default 60000ms); set INDEX_ONCE=1 for a single pass
# INDEX_INTERVAL_MS=60000
# INDEX_ONCE=1
