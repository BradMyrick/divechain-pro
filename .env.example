# Client-side env vars for Divechain Pro (Vite exposes VITE_*-prefixed vars to the app).
# Copy to `.env.local` for local dev. In production these are set in the Vercel project.

# WalletConnect Cloud project id — create one at https://cloud.reown.com (formerly WalletConnect Cloud).
# This is a PUBLIC client identifier (it ships in the browser bundle by design), not a secret.
VITE_WALLETCONNECT_PROJECT_ID=
