# Client-side env vars for DiveChain (Vite exposes VITE_*-prefixed vars to the app).
# Copy to `.env.local` for local dev. In production these are set in the Vercel project.

# Reown projectId; the origin must be allowlisted at the Reown dashboard
# (divechain.pro, www, vercel.app). Create one at https://cloud.reown.com.
# This is a PUBLIC client identifier (it ships in the browser bundle by design), not a secret.
VITE_WALLETCONNECT_PROJECT_ID=

# Server-only (Vercel Functions). Never prefix with VITE_. Never commit real values.
# RESEND_API_KEY=
# RESEND_SEGMENT_ID=
# SUBSCRIBE_ALLOWED_ORIGINS=https://divechain.pro,https://www.divechain.pro
